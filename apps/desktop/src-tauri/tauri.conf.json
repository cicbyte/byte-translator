{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "byte-translator",
  "version": "0.1.0",
  "identifier": "com.cicbyte.byte-translator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:51431",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "byte-translator",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "decorations": false
      },
      {
        "label": "lookup",
        "title": "快速翻译",
        "url": "index.html#/lookup",
        "width": 380,
        "height": 300,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; font-src 'self' data:; frame-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
